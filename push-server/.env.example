WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
ADMIN_PUSH_TOKEN=
PRODAMUS_SECRET_KEY=
AUTH_SERVICE_SECRET=
# FEAT-015 BotHunter авто-пауза: токен в query ?token=… (пустой → endpoint отдаёт 503)
BOTHUNTER_WEBHOOK_TOKEN=
CORS_ORIGIN=https://your-domain.example.com

# Вебхуки СДЭК → уведомления Ольге в Telegram (cdekWebhook.mjs).
# Пустой CDEK_WEBHOOK_TOKEN (или любой другой пустой ключ) → модуль спит.
# Токен идёт сегментом пути: POST /webhooks/cdek/<CDEK_WEBHOOK_TOKEN>
CDEK_WEBHOOK_TOKEN=
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_API_BASE=https://api.cdek.ru/v2
CDEK_NOTIFY_BOT_TOKEN=
CDEK_NOTIFY_CHAT_ID=
# ВАЖНО: здесь строковые коды из ответа API СДЭК (GET /orders → statuses[].code),
# а НЕ числа из вебхука. Вебхук шлёт status_code числом старого справочника
# (12 = ACCEPTED_AT_PICK_UP_POINT, 9 = ACCEPTED_IN_RECIPIENT_CITY) и для решений
# не используется — статус всегда берётся из API.

# Статус, по которому шлём «Новый заказ».
CDEK_NOTIFY_STATUSES=CREATED
# Не считать новым заказ, созданный давно: узнали о нём поздно — уведомление не нужно.
CDEK_NEW_ORDER_MAX_AGE_HOURS=24
# Статусы «посылка легла в пункт выдачи» — с них пошли часы.
CDEK_WAITING_STATUSES=ACCEPTED_AT_PICK_UP_POINT,POSTOMAT_POSTED
# Статусы «заказ закрыт»: забрали, вернули, удалили.
CDEK_CLOSED_STATUSES=DELIVERED,POSTOMAT_RECEIVED,NOT_DELIVERED,RETURNED_TO_SENDER_CITY_WAREHOUSE,RETURNED_TO_SENDER,REMOVED,INVALID
# Через сколько часов лежания напомнить Ольге о незабранном заказе.
# Трое суток: письмо клиенту о прибытии уходит сразу, и первые сутки-двое —
# нормальный срок, чтобы человек дошёл до пункта выдачи.
CDEK_WAITING_HOURS=72
# Как часто проходить по реестру, минуты.
CDEK_SCAN_MINUTES=60
# Как часто перечитывать незакрытый заказ из API, даже если событий по нему нет.
# Страховка от потерянного вебхука: лежащая посылка статус не меняет, и без
# этого часы по ней не пошли бы никогда.
CDEK_REFRESH_HOURS=12
# Потолок перечитываний за один проход, чтобы не устроить залп запросов к СДЭК.
CDEK_REFRESH_LIMIT=50
# Реестр заказов — обычный JSON рядом с сервисом, базы не касается.
CDEK_STORE_PATH=/opt/push-server/cdek-orders.json

# Письмо клиенту «посылка приехала» (cdekClientMail.mjs). Уходит сразу, как
# посылка легла в пункт выдачи, — отдельно от напоминания Ольге.
# Включатель отдельный намеренно: без CDEK_CLIENT_MAIL=on модуль спит,
# даже когда ключ NotiSend задан.
CDEK_CLIENT_MAIL=
# Ключ NotiSend — лежит в ~/.skrebeyko/credentials.env
NOTISEND_API_KEY=
